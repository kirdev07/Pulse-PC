<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- ===== Выбор ПК (пока ПК не подключён, больше ничего недоступно) ===== -->
    <ScrollView
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="24dp"
                android:contentDescription="Pulse PC"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_full" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_gravity="center_horizontal"
                android:text="Выберите компьютер для управления"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/savedTitle"
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="МОИ ПК" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshBtn"
                    style="@style/BtnIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Обновить список ПК"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="22dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/savedEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Пока нет сохранённых. Найдите ПК ниже."
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/savedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПК В СЕТИ" />

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/foundList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/connectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Приложение: доступно только при подключённом ПК ===== -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Верхняя панель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pcName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pcState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectBtn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сменить ПК"
                app:icon="@drawable/ic_swap" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== Главная ===== -->
            <ScrollView
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/container"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:id="@+id/statsBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/powerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="БЫСТРЫЕ ДЕЙСТВИЯ" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lockBtn"
                            style="@style/Btn"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Блокировка"
                            app:icon="@drawable/ic_lock" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sleepBtn"
                            style="@style/Btn"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Сон"
                            app:icon="@drawable/ic_sleep" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/restartBtn"
                            style="@style/Btn"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Перезагрузка"
                            app:icon="@drawable/ic_restart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shutdownBtn"
                            style="@style/Btn"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Выключение"
                            app:icon="@drawable/ic_power" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelPowerBtn"
                        style="@style/BtnOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Отменить таймер"
                        app:icon="@drawable/ic_close" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/closeActive"
                        style="@style/BtnOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Закрыть активное окно"
                        app:icon="@drawable/ic_close" />
                </LinearLayout>
            </ScrollView>

            <!-- ===== Программы (Программы / Сценарии / Окна) ===== -->
            <LinearLayout
                android:id="@+id/pageApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/appTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg"
                    app:tabIndicatorColor="@color/accent"
                    app:tabSelectedTextColor="@color/accent_light"
                    app:tabTextColor="@color/text_dim" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ScrollView
                        android:id="@+id/tabPrograms"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/programsEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Список пуст. Добавьте программы на вкладке «Программы» в приложении на ПК."
                                android:textColor="@color/text_dim"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:id="@+id/programsList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </ScrollView>

                    <ScrollView
                        android:id="@+id/tabScenarios"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/scenariosEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Сценариев нет. Создайте их в ПК‑приложении: Настройки → Возможности бота."
                                android:textColor="@color/text_dim"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:id="@+id/scenariosList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </ScrollView>

                    <ScrollView
                        android:id="@+id/tabWindows"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:id="@+id/windowsList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </ScrollView>
                </FrameLayout>
            </LinearLayout>

            <!-- ===== Файлы ===== -->
            <LinearLayout
                android:id="@+id/pageFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/filesPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filesUp"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="64dp"
                        app:iconGravity="top"
                        android:text="Наверх"
                        app:icon="@drawable/ic_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filesUpload"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="64dp"
                        app:iconGravity="top"
                        android:text="На ПК"
                        app:icon="@drawable/ic_upload" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filesHistory"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:minHeight="64dp"
                        app:iconGravity="top"
                        android:text="История"
                        app:icon="@drawable/ic_history" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/filesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp" />
                </ScrollView>
            </LinearLayout>

            <!-- ===== Аудио (плеер) ===== -->
            <ScrollView
                android:id="@+id/pageAudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/container"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="232dp"
                                android:layout_height="232dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="@color/container_highest"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/coverImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:alpha="0.5"
                                    android:contentDescription="Обложка"
                                    android:padding="72dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_music" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/trackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:ellipsize="marquee"
                                android:gravity="center_horizontal"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:singleLine="true"
                                android:text="Ничего не играет"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trackArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:gravity="center_horizontal"
                                android:singleLine="true"
                                android:textColor="@color/text_dim"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/trackSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/chip"
                                android:paddingStart="12dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp"
                                android:visibility="gone" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/trackSeek"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:valueFrom="0"
                                android:valueTo="100"
                                app:haloRadius="18dp"
                                app:labelBehavior="gone"
                                app:thumbColor="@color/accent_light"
                                app:thumbElevation="0dp"
                                app:thumbHeight="16dp"
                                app:thumbWidth="16dp"
                                app:thumbTrackGapSize="0dp"
                                app:trackColorActive="@color/accent"
                                app:trackColorInactive="@color/container_highest"
                                app:trackCornerSize="4dp"
                                app:trackHeight="6dp"
                                app:trackInsideCornerSize="4dp"
                                app:trackStopIndicatorSize="0dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <TextView
                                    android:id="@+id/trackElapsed"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0:00"
                                    android:textColor="@color/text_dim"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/trackTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0:00"
                                    android:textColor="@color/text_dim"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/mediaPrev"
                                    style="@style/BtnIcon"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    app:icon="@drawable/ic_prev"
                                    app:iconSize="28dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/mediaPlay"
                                    style="@style/BtnIconFilled"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    app:icon="@drawable/ic_play"
                                    app:iconSize="38dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/mediaNext"
                                    style="@style/BtnIcon"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    app:icon="@drawable/ic_next"
                                    app:iconSize="28dp" />
                            </LinearLayout>

                            <!-- Громкость ПК прямо в плеере: − · без звука · + -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/volDown"
                                    style="@style/BtnIcon"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    app:icon="@drawable/ic_voldown" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/volMute"
                                    style="@style/BtnIcon"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    app:icon="@drawable/ic_mute" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/volUp"
                                    style="@style/BtnIcon"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    app:icon="@drawable/ic_volup" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/libraryBtn"
                        style="@style/BtnFill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Выбрать музыку на ПК"
                        app:icon="@drawable/ic_library" />

                </LinearLayout>
            </ScrollView>

            <!-- ===== Экран ===== -->
            <ScrollView
                android:id="@+id/pageScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shotBtn"
                        style="@style/BtnFill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="Сделать скриншот"
                        app:icon="@drawable/ic_camera" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/monitorBtn"
                        style="@style/BtnOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Экран: основной"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/shotCard"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/container"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/shotImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="Скриншот" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОТКРЫТЬ ССЫЛКУ НА ПК" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://…"
                        app:startIconDrawable="@drawable/ic_link">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openUrlBtn"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Открыть" />

                    <TextView
                        style="@style/Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ПОИСК В БРАУЗЕРЕ ПК" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Что искать"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/searchInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchBtn"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Искать" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Нижняя панель: только при подключённом ПК -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.Material3.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/container"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <!-- Баннер с логотипом: «Подключено», «Файл скачан» -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/banner"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/accent_container"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Pulse PC"
                android:src="@drawable/logo_emblem" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bannerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
