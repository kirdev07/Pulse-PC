<resources>
    <style name="Theme.PulsePC" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiaryContainer">@color/container_highest</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceContainer">@color/container</item>
        <item name="colorSurfaceContainerHigh">@color/container_high</item>
        <item name="colorSurfaceContainerHighest">@color/container_highest</item>
        <item name="colorSurfaceContainerLow">@color/container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Btn" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="BtnFill" parent="Widget.Material3.Button">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="BtnOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="BtnIcon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="BtnIconFilled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Section">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
